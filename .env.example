# Copiar a .env y completar.
# config.py trae valores por defecto; estas variables los sobreescriben.

# --- Base de datos GLPI (MySQL) ---
GLPI_DB_HOST=10.48.63.60
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_rpt
GLPI_DB_PASSWORD=
GLPI_DB_NAME=glpidb

# --- Telegram ---
TG_BOT_TOKEN=
TG_CHAT_ID=
# Técnico -> chat_id para los mensajes privados. Clave = login de GLPI (o nombre).
# Formato: login:chat_id separados por coma.  Ej: jperez:123456789,mlopez:987654321
# También acepta JSON: {"jperez": "123456789"}
TG_MEMBERS=

# --- Reportes GLPI ---
# Grupo de GLPI (glpi_groups_users.groups_id) cuyos tickets se reportan.
GLPI_GROUP_ID=11
# Horas de anticipación del reporte "próximos a vencer".
NEAR_DUE_HOURS=24
# Gráfica PNG (barras por técnico + dona de totales) enviada al grupo (1=sí, 0=no).
SEND_CHART=1
# URL base de GLPI para enlazar cada ticket. Vacío = sin enlaces.
# Ej: http://10.48.63.60/glpi
GLPI_BASE_URL=

# --- Monitor de Ventas EPA ---
# UI (solo para el screenshot). SV se refresca 2 veces (ver config.COUNTRIES).
MONITOR_BASE_URL=http://10.48.12.77:3500
MONITOR_DAYS_BACK=1
# Enviar screenshot del Monitor a Telegram (1=sí, 0=no)
MONITOR_SEND_IMAGE=1
MONITOR_RENDER_TIMEOUT_MS=20000

# API REST del Monitor (fuente de datos de las VENTAS, igual que reporte_joseph).
# OBLIGATORIA: sin esta clave el login del Monitor falla.
MONITOR_API_URL=http://10.48.12.77:3010
MONITOR_API_USER=EpaSupport2023
MONITOR_API_PASS=
MONITOR_API_TIMEOUT=45
MONITOR_API_LIMIT=200
MONITOR_VENTAS_ENDPOINT=transaction-ventas-front-count

# --- General ---
LOG_LEVEL=INFO
TIMEZONE=America/Caracas
